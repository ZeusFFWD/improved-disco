<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Archery 18m/25m Scorer</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; padding: 1rem; background:#111; color:#eee; }
    h1 { font-size: 1.4rem; margin-bottom: 0.5rem; }
    .section { margin-bottom: 1.5rem; }
    .buttons-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 0.5rem 0; }
    button {
      padding: 0.6rem 0.9rem;
      font-size: 1rem;
      border-radius: 0.4rem;
      border: none;
      cursor: pointer;
      background:#333; color:#eee;
    }
    button.primary { background:#0a84ff; color:white; }
    button.danger { background:#b00020; color:white; }
    button.small { font-size: 0.85rem; padding: 0.3rem 0.5rem; }
    button:disabled { opacity: 0.4; cursor: default; }
    .pill { padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; background:#222; display:inline-block; }
    .card { border-radius:0.6rem; padding:0.8rem; background:#1b1b1b; margin-bottom:0.5rem; }
    .flex { display:flex; align-items:center; justify-content:space-between; gap:0.5rem; }
    .history-list { max-height: 40vh; overflow:auto; }
    input, textarea {
      width: 100%; padding: 0.4rem 0.6rem; border-radius:0.4rem;
      border:1px solid #444; background:#111; color:#eee;
      box-sizing: border-box; font-size:0.9rem;
    }
    textarea { min-height: 3rem; }
    .meta { font-size: 0.8rem; color:#aaa; }
    .score-big { font-size: 1.4rem; font-weight: 600; }
    .end-info { font-size:0.95rem; color:#ccc; }
    .tag { font-size:0.75rem; padding:0.1rem 0.4rem; border-radius:0.3rem; background:#222; }
    .best { border:1px solid #0a84ff; }
  </style>
</head>
<body>
  <h1>Archery Scorer (18m / 25m)</h1>
  <div class="section" id="new-round-section">
    <div class="pill">New round</div>
    <p>Fixed: 10 ends × 3 arrows, max 300.</p>
    <div class="buttons-row">
      <button class="primary" onclick="startRound(18)">Start 18m round</button>
      <button class="primary" onclick="startRound(25)">Start 25m round</button>
    </div>
    <label>
      Notes (optional for next round):
      <textarea id="next-notes" placeholder="e.g. new string, windy, barebow..."></textarea>
    </label>
  </div>

  <div class="section" id="scoring-section" style="display:none;">
    <div class="pill">Scoring</div>
    <div class="card">
      <div class="flex">
        <div>
          <div class="end-info" id="round-label"></div>
          <div class="end-info" id="end-arrow-label"></div>
        </div>
        <div class="score-big" id="score-label"></div>
      </div>
      <div class="meta" id="notes-label"></div>
    </div>

    <div class="buttons-row" id="arrow-buttons">
      <button onclick="addArrow('X')">X</button>
      <button onclick="addArrow(10)">10</button>
      <button onclick="addArrow(9)">9</button>
      <button onclick="addArrow(8)">8</button>
      <button onclick="addArrow(7)">7</button>
      <button onclick="addArrow(6)">6</button>
      <button onclick="addArrow(5)">5</button>
      <button onclick="addArrow(4)">4</button>
      <button onclick="addArrow(3)">3</button>
      <button onclick="addArrow(2)">2</button>
      <button onclick="addArrow(1)">1</button>
      <button onclick="addArrow('M')" class="danger">M</button>
    </div>

    <div class="buttons-row">
      <button class="small" onclick="undoArrow()">Undo arrow</button>
      <button class="small" onclick="prevEnd()">◀ Prev end</button>
      <button class="small" onclick="nextEnd()">Next end ▶</button>
      <button class="small danger" onclick="cancelRound()">Cancel round</button>
    </div>
    <div class="meta" id="end-summary"></div>
  </div>

  <div class="section" id="history-section">
    <div class="pill">History</div>
    <div class="buttons-row">
      <button class="small" onclick="clearHistory()">Clear all history</button>
    </div>
    <div class="history-list" id="history-list"></div>
  </div>

<script>
const STORAGE_KEY = 'archeryRounds_v1';

function loadRounds() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    return raw ? JSON.parse(raw) : [];
  } catch {
    return [];
  }
}

function saveRounds(rounds) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(rounds));
}

function scoreArrow(v) {
  if (v === 'X') return 10;
  if (v === 'M') return 0;
  return Number(v);
}

function endTotal(end) {
  return end.reduce((sum, v) => sum + scoreArrow(v), 0);
}

function roundTotal(ends) {
  return ends.reduce((sum, e) => sum + endTotal(e), 0);
}

let currentRound = null; // { id, date, distance, notes, ends:[[...],[...],...], currentEnd, currentArrow }

function startRound(distance) {
  const notes = document.getElementById('next-notes').value.trim();
  const now = new Date();
  currentRound = {
    id: now.getTime(),
    date: now.toISOString(),
    distance,
    notes,
    ends: Array.from({ length: 10 }, () => []),
    currentEnd: 0,
    currentArrow: 0
  };
  document.getElementById('next-notes').value = '';
  showScoring();
}

function cancelRound() {
  currentRound = null;
  document.getElementById('scoring-section').style.display = 'none';
  renderHistory();
}

function addArrow(value) {
  if (!currentRound) return;
  const { currentEnd, currentArrow } = currentRound;
  if (currentEnd >= 10 || currentArrow >= 3) return;

  currentRound.ends[currentEnd][currentArrow] = value;
  currentRound.currentArrow++;

  if (currentRound.currentArrow >= 3 && currentRound.currentEnd < 9) {
    currentRound.currentEnd++;
    currentRound.currentArrow = currentRound.ends[currentRound.currentEnd].length;
  }

  if (isRoundFinished(currentRound)) {
    finishRound();
    return;
  }

  updateScoringUI();
}

function undoArrow() {
  if (!currentRound) return;
  let { currentEnd, currentArrow } = currentRound;

  if (currentArrow === 0 && currentEnd === 0 && currentRound.ends[0].length === 0) return;

  if (currentArrow === 0) {
    currentEnd--;
    currentArrow = currentRound.ends[currentEnd].length;
  }

  if (currentArrow > 0) {
    currentRound.ends[currentEnd].pop();
    currentArrow--;
  }

  currentRound.currentEnd = currentEnd;
  currentRound.currentArrow = currentArrow;
  updateScoringUI();
}

function nextEnd() {
  if (!currentRound) return;
  if (currentRound.currentEnd < 9) {
    currentRound.currentEnd++;
    currentRound.currentArrow = currentRound.ends[currentRound.currentEnd].length;
    updateScoringUI();
  }
}

function prevEnd() {
  if (!currentRound) return;
  if (currentRound.currentEnd > 0) {
    currentRound.currentEnd--;
    currentRound.currentArrow = currentRound.ends[currentRound.currentEnd].length;
    updateScoringUI();
  }
}

function isRoundFinished(r) {
  return r.ends.every(end => end.length === 3);
}

function finishRound() {
  if (!currentRound) return;
  const rounds = loadRounds();
  rounds.push({
    id: currentRound.id,
    date: currentRound.date,
    distance: currentRound.distance,
    notes: currentRound.notes,
    ends: currentRound.ends
  });
  saveRounds(rounds);
  currentRound = null;
  document.getElementById('scoring-section').style.display = 'none';
  renderHistory();
}

function showScoring() {
  document.getElementById('scoring-section').style.display = 'block';
  updateScoringUI();
}

function updateScoringUI() {
  if (!currentRound) return;
  const total = roundTotal(currentRound.ends);
  const roundLabel = `Distance: ${currentRound.distance}m · 10 ends × 3 arrows · Max 300`;
  const endArrowLabel = `End ${currentRound.currentEnd + 1} of 10 · Arrow ${currentRound.currentArrow + 1} of 3`;
  const notes = currentRound.notes ? `Notes: ${currentRound.notes}` : '';

  document.getElementById('round-label').textContent = roundLabel;
  document.getElementById('end-arrow-label').textContent = endArrowLabel;
  document.getElementById('score-label').textContent = `${total} / 300`;
  document.getElementById('notes-label').textContent = notes;

  const end = currentRound.ends[currentRound.currentEnd];
  const endScore = endTotal(end);
  document.getElementById('end-summary').textContent =
    `Current end scores: [${end.join(', ')}] · End total: ${endScore}`;
}

function formatDate(iso) {
  const d = new Date(iso);
  return d.toLocaleString(undefined, {
    year:'numeric', month:'short', day:'numeric',
    hour:'2-digit', minute:'2-digit'
  });
}

function renderHistory() {
  const list = document.getElementById('history-list');
  list.innerHTML = '';
  const rounds = loadRounds();
  if (rounds.length === 0) {
    list.innerHTML = '<p class="meta">No rounds saved yet.</p>';
    return;
  }

  let bestScore = -1;
  rounds.forEach(r => {
    const total = roundTotal(r.ends || []);
    if (total > bestScore) bestScore = total;
  });

  rounds
    .slice()
    .sort((a, b) => b.date.localeCompare(a.date))
    .forEach(r => {
      const total = roundTotal(r.ends || []);
      const isBest = total === bestScore;
      const div = document.createElement('div');
      div.className = 'card' + (isBest ? ' best' : '');
      div.innerHTML = `
        <div class="flex">
          <div>
            <div><strong>${total}</strong> / 300 · <span class="tag">${r.distance}m</span></div>
            <div class="meta">${formatDate(r.date)}</div>
            ${r.notes ? `<div class="meta">Notes: ${r.notes}</div>` : ''}
          </div>
          <button class="small danger" onclick="deleteRound(${r.id})">Delete</button>
        </div>
      `;
      list.appendChild(div);
    });
}

function deleteRound(id) {
  let rounds = loadRounds();
  rounds = rounds.filter(r => r.id !== id);
  saveRounds(rounds);
  renderHistory();
}

function clearHistory() {
  if (!confirm('Clear all saved rounds?')) return;
  localStorage.removeItem(STORAGE_KEY);
  renderHistory();
}

renderHistory();
</script>
</body>
</html>
